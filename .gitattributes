* text=auto

# Source files
*.cs text eol=lf
*.csproj text eol=lf
*.sln text eol=crlf
*.props text eol=lf
*.targets text eol=lf

# Common text files
*.md text eol=lf
*.json text eol=lf
*.xml text eol=lf
*.config text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.txt text eol=lf
*.ps1 text eol=crlf
*.cmd text eol=crlf
*.bat text eol=crlf
.editorconfig text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf

# Office and generated document formats
*.doc binary
*.docx binary
*.rtf binary
*.pdf binary

# Images and media
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.svg text eol=lf

# Archives, binaries, and build artifacts
*.zip binary
*.7z binary
*.tar binary
*.gz binary
*.exe binary
*.dll binary
*.pdb binary
